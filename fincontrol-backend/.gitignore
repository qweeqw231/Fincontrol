# ============================================
# FinControl Backend .gitignore
# ============================================

# Maven 构建产物
target/
*.class
*.jar
*.war
*.ear
*.log

# IDE
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# 上传文件（运行时生成）
uploads/
*.png
*.jpg
*.jpeg
*.webp

# 环境变量
.env
.env.local

# 本地 Spring Boot 配置（覆盖 application.yml，不应提交）
application-local.yml
application-local.yaml
application-local.properties

# 临时文件
*.tmp
*.bak
*.swp

# 系统文件
.DS_Store
Thumbs.db