# ============================================
# FinControl Workspace .gitignore
# ============================================
# 本文件为工作区根级忽略规则，覆盖 IDE、操作系统、
# 以及子仓库可能泄漏到工作区的构建产物。
# 各子仓库（fincontrol-backend/、fincontrol-frontend/）
# 应自行维护更细粒度的 .gitignore。

# ------------------------------------------
# IDE
# ------------------------------------------
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ------------------------------------------
# 操作系统
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db
ehthumbs_vista.db
.Trashes
.Spotlight-V100
.fseventsd
.AppleDouble
.LSOverride

# ------------------------------------------
# 子仓库构建产物兜底
# （子仓库自有 .gitignore 为主，这里只兜底）
# ------------------------------------------

# Java / Maven / Gradle
**/target/
**/.gradle/
**/build/
**/out/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Node / npm / yarn / pnpm
**/node_modules/
**/dist/
**/.next/
**/.nuxt/
**/.vuepress/dist/
**/coverage/
.npm
.yarn-integrity
.pnpm-store/
*.tgz

# React/Vite 产物
**/.vite/
**/*.local

# ------------------------------------------
# 日志与临时文件
# ------------------------------------------
*.log
*.log.*
logs/
*.pid
*.seed
*.pid.lock

# ------------------------------------------
# 环境变量与密钥
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
secrets.yml

# ------------------------------------------
# 数据库与上传文件
# ------------------------------------------
*.sqlite
*.sqlite3
*.db
**/uploads/
**/tmp/

# ------------------------------------------
# 测试产物
# ------------------------------------------
**/test-output/
**/reports/
**/.pytest_cache/
**/coverage/
**/.nyc_output/

# ------------------------------------------
# 文档与备份
# ------------------------------------------
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej

# ------------------------------------------
# 工作区特殊
# ------------------------------------------
# 评审过程中产生的临时草稿（评审结束后应清理）
drafts/
scratch/

# 工作区级临时调试区（scripts/ 才是稳定的，调试脚本请移过去）
.tmp/

# 1a.7 调试产物（按需清理）
backend.log
build.log
compile.log
.backend.pid
fincontrol-backend/backend.log

# 防御性：Docker 输出串到 CWD 时可能在根目录写的 0 字节脏文件
/docker
/eclipse-temurin
/health
/UP

# 工具脚本临时输出（如 commit-and-push.sh 写出的 git-commit-msg.txt）
git-commit-msg.txt

# 1a.7 smoke 脚本产生的 API 响应输出
docs/test-records/manual-tests/api-test-output/
